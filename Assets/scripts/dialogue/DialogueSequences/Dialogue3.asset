  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8407d2bb1aa99bc41b1580ad88bc7cdb, type: 3}
  m_Name: Dialogue3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Ashen
    text: "You\u2019ve grown stronger\u2026 but strength alone won\u2019t tame the
      flame."
    portrait: {fileID: -8030570891474961867, guid: a520c24396b8a9744a637ef1a4809e9f, type: 3}
  - speakerName: Lyra
    text: "I don\u2019t want to tame it. I want to carry it."
    portrait: {fileID: -8030570891474961867, guid: 26a2fe74e64cab4469e671427796c401, type: 3}
  - speakerName: Ashen
    text: Then it will consume you, as it consumed me.
    portrait: {fileID: -8030570891474961867, guid: a520c24396b8a9744a637ef1a4809e9f, type: 3}
  - speakerName: Lyra
    text: "Maybe. But I\u2019ll burn on my own terms."
    portrait: {fileID: -8030570891474961867, guid: 26a2fe74e64cab4469e671427796c401, type: 3}
  - speakerName: Ashen
    text: "Bold words\u2026 we\u2019ll see if they last. The forest will call me
      again."
    portrait: {fileID: -8030570891474961867, guid: a520c24396b8a9744a637ef1a4809e9f, type: 3}
  - speakerName: Lyra
    text: "And when it does, I\u2019ll be ready."
    portrait: {fileID: -8030570891474961867, guid: 26a2fe74e64cab4469e671427796c401, type: 3}
